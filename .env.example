# ==============================================================================
# QuickPDF Root Environment Configuration Template
# ==============================================================================

# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./backend/dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://quickpdf_user:secure_password@localhost:5432/quickpdf_prod?schema=public"
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_string
JOB_SECRETS_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_or_random_secret_string
FRONTEND_URL=http://localhost:3000
# File Storage Configuration (In production, STORAGE_ROOT must be an absolute path)
STORAGE_PROVIDER=local
STORAGE_ROOT=/var/lib/quickpdf/uploads
MAX_FILE_SIZE_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=104857600
MAX_CONCURRENT_JOBS=4

# SMTP Configuration (Mandatory in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="QuickPDF" <noreply@yourdomain.com>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_APP_URL=http://localhost:3000
