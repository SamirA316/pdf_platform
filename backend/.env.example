# ==============================================================================
# QuickPDF Backend Environment Configuration
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development
PORT=3001

# Database Configuration
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Recommended for Production Deployment):
# DATABASE_URL="postgresql://quickpdf_user:secure_password@localhost:5432/quickpdf_prod?schema=public"

# Frontend Client URL (for CORS & Cookie Origin validation)
FRONTEND_URL=http://localhost:3000

# Cryptographic Secret for JWT & HMAC tokens (Min 32 characters required in production)
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_string

# Job Secrets AES-256-GCM Encryption Key (MANDATORY IN PRODUCTION - 32 bytes or 64 hex characters)
JOB_SECRETS_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_or_random_secret_string

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_ROOT=/var/lib/quickpdf/uploads

# Quota & File Size Limits (Aligned with Frontend)
# Max Single Upload File Size (50 MB in bytes)
MAX_FILE_SIZE_BYTES=52428800
# Total Per-User Storage Quota (100 MB in bytes)
USER_STORAGE_QUOTA_BYTES=104857600

# Worker Concurrency Limit (Default 4)
MAX_CONCURRENT_JOBS=4

# Email / SMTP Configuration (MANDATORY IN PRODUCTION - Missing credentials triggers fatal startup halt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@domain.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="QuickPDF" <noreply@quickpdf.local>
