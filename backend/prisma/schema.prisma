generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isVerified Boolean @default(false)
  otp       String?
  otpExpires DateTime?
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  size         Int
  type         String   @default("UPLOAD") // e.g., UPLOAD, MERGED, SPLIT
  path         String   // Local file path
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
